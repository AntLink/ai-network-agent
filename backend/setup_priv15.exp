#!/usr/bin/expect -f

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null admin@172.22.45.249
expect "Password:"
send "Admin123!\r"
expect ">"
send "enable\r"
expect "Password:"
send "Admin123!\r"
expect "#"
send "configure terminal\r"
expect "(config)#"
send "username admin privilege 15 secret Admin123!\r"
expect "(config)#"
send "aaa new-model\r"
expect "(config)#"
send "aaa authentication login default local\r"
expect "(config)#"
send "aaa authorization exec default local if-authenticated\r"
expect "(config)#"
send "line vty 0 4\r"
expect "(config-line)#"
send "login authentication default\r"
expect "(config-line)#"
send "transport input ssh\r"
expect "(config-line)#"
send "exit\r"
expect "(config)#"
send "end\r"
expect "#"
send "write memory\r"
expect "#"
send "show privilege\r"
expect "#"
send "exit\r"
expect eof