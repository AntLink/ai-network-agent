# URL backend FastAPI ai-network-agent (pastikan sudah berjalan)
BACKEND_URL=http://127.0.0.1:8000
API_V1_PREFIX=/api/v1

# Isi bila backend memakai token (Authorization: Bearer). Kosongkan jika tidak ada.
API_TOKEN=

# Transport MCP: stdio (default, untuk opencode/OpenHands lokal) | sse | http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8911

# Identitas default saat config_apply / approval (boleh diganti)
DEFAULT_APPROVED_BY=mcp-bridge

# Timeout request ke backend (detik)
REQUEST_TIMEOUT=120