# Candidate vhost for edge-control.antlinx.com.
# Install only after production PKI paths and Central listener are validated.
# This is a server-block snippet for the existing Nginx http context.

upstream ainet_central_internal {
    server 127.0.0.1:8010;
}

map $ssl_client_s_dn $ainet_edge_id {
    default "";
    ~^CN=(?<edge_cn>[^,]+) $edge_cn;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name edge-control.antlinx.com;

    ssl_certificate     /etc/letsencrypt/live/antlinx.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/antlinx.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    ssl_client_certificate /etc/ainet/pki/edge-client-ca.crt;
    ssl_verify_client on;
    ssl_crl /etc/ainet/pki/edge-client-ca.crl;

    location / {
        proxy_pass http://ainet_central_internal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Client-Cert-Fingerprint $ssl_client_fingerprint;
        proxy_set_header X-Client-Cert $ssl_client_escaped_cert;
        proxy_set_header X-Client-Edge-ID $ainet_edge_id;
        proxy_read_timeout 60s;
    }
}
