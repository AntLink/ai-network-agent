# Reference mTLS edge-control terminator configuration.
# Production values must be mounted as secrets/configuration, never committed.
events {}

http {
    upstream central_api {
        server central:8000;
    }

    map $ssl_client_s_dn $client_edge_id {
        default "";
        ~^CN=(?<edge_cn>[^,]+) $edge_cn;
    }

    server {
        listen 8443 ssl;
        server_name central;

        ssl_protocols TLSv1.3;
        ssl_certificate     /etc/ainet/pki/central.crt;
        ssl_certificate_key /etc/ainet/pki/central.key;
        ssl_client_certificate /etc/ainet/pki/ca.crt;
        ssl_verify_client on;
        # CRL must be regenerated/reloaded after every certificate revoke.
        ssl_crl /etc/ainet/pki/ca.crl;

        location / {
            proxy_pass http://central_api;
            proxy_set_header X-Client-Edge-ID $client_edge_id;
            # This header must be generated by a trusted terminator module from
            # the verified peer certificate. Strip any client-supplied value.
            proxy_set_header X-Client-Cert-Fingerprint "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
